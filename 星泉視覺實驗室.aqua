變數 介面 = 匯入("中文介面.aqua");
變數 畫 = 介面.繪圖;
變數 姿態模型 = 匯入("姿態模型.aqua");
變數 臉部模型 = 匯入("臉部模型.aqua");
變數 模型 = 姿態模型;
變數 範例 = 0;
變數 範例名稱 = ["人體姿態 · 33 個關鍵點", "臉部關鍵點 · 468 個關鍵點"];
變數 選單展開 = 假;
變數 選單項目 = 0;
變數 引擎 = 匯入("推論引擎");
變數 攝影機 = 0;
如果 (是Android()) { 攝影機 = 匯入("相機"); }
否則如果 (是網頁()) { 攝影機 = 匯入("網路攝影機"); }
否則 { 攝影機 = 匯入("網路攝影機"); }
變數 拍攝 = 0;
變數 運作中 = 假;
變數 圖片 = 0;
變數 有圖片 = 假;
變數 圖形加速 = 真;
變數 狀態 = "選擇範例與推論方式，開始觀察關鍵點。";
變數 影格耗時 = 0.0d;
變數 影格率 = 0.0d;
變數 上次影格 = 0.0d;
變數 影像寬 = 512.0d;
變數 影像高 = 384.0d;
變數 影像左 = 40.0d;
變數 影像上 = 250.0d;
變數 比例 = 1.0d;
變數 直式 = 假;
變數 左邊 = 0.0d;
變數 上邊 = 0.0d;
變數 連線 = [[11, 12], [11, 13], [13, 15], [12, 14], [14, 16], [11, 23], [12, 24], [23, 24], [23, 25], [25, 27], [24, 26], [26, 28], [27, 29], [29, 31], [28, 30], [30, 32], [15, 17], [15, 19], [16, 18], [16, 20]];
變數 臉部輪廓 = [
    [10, 338, 297, 332, 284, 251, 389, 356, 454, 323, 361, 288, 397, 365, 379, 378, 400, 377, 152, 148, 176, 149, 150, 136, 172, 58, 132, 93, 234, 127, 162, 21, 54, 103, 67, 109, 10],
    [33, 7, 163, 144, 145, 153, 154, 155, 133, 173, 157, 158, 159, 160, 161, 246, 33],
    [263, 249, 390, 373, 374, 380, 381, 382, 362, 398, 384, 385, 386, 387, 388, 466, 263],
    [61, 146, 91, 181, 84, 17, 314, 405, 321, 375, 291, 409, 270, 269, 267, 0, 37, 39, 40, 185, 61],
    [78, 95, 88, 178, 87, 14, 317, 402, 318, 324, 308, 415, 310, 311, 312, 13, 82, 81, 80, 191, 78],
    [70, 63, 105, 66, 107], [336, 296, 334, 293, 300], [168, 6, 197, 195, 5, 4, 1]
];
變數 停止 = 函式() {
    如果 (運作中) { 拍攝.釋放(); }
    運作中 = 假; 模型.釋放(); 有圖片 = 假; 圖片 = 0;
    影格耗時 = 0.0d; 影格率 = 0.0d; 上次影格 = 0.0d;
    狀態 = "已停止。可重新選擇範例與推論方式。";
};
變數 切換範例 = 函式(項目) {
    選單展開 = 假; 選單項目 = 項目;
    如果 (範例 != 項目) {
        停止(); 範例 = 項目; 模型 = 姿態模型;
        如果 (範例 == 1) { 模型 = 臉部模型; }
        狀態 = "已切換範例。選擇推論方式即可啟動攝影機。";
    }
};
變數 啟動 = 函式(使用加速) {
    停止(); 選單展開 = 假; 圖形加速 = 使用加速;
    變數 後端 = 引擎.中央處理器; 如果 (使用加速) { 後端 = 引擎.網頁圖形加速; }
    如果 (!引擎.是否支援(後端)) { 狀態 = "此環境無法使用圖形加速，請選擇中央處理器。"; 回傳 假; }
    模型.載入(後端);
    拍攝 = 攝影機.開啟("", 640, 480, 30); 運作中 = 真; 上次影格 = 0;
    狀態 = "正在尋找人物；請讓主要身體部位清楚入鏡。";
    如果 (範例 == 1) { 狀態 = "正在尋找臉部；請面向攝影機並讓整張臉清楚入鏡。"; }
    回傳 真;
};
變數 處理點擊 = 函式() {
    變數 橫 = (介面.滑鼠橫座標() - 左邊) / 比例;
    變數 縱 = (介面.滑鼠縱座標() - 上邊) / 比例;
    如果 (直式 && 縱 >= 760) { 橫 += 560; 縱 -= 570; }
    如果 (選單展開) {
        如果 (橫 >= 600 && 橫 <= 996 && 縱 >= 278 && 縱 < 378) {
            變數 項目 = 0; 如果 (縱 >= 328) { 項目 = 1; }
            切換範例(項目);
        } 否則 { 選單展開 = 假; }
        回傳 0;
    }
    如果 (橫 >= 600 && 橫 <= 996) {
        如果 (縱 >= 218 && 縱 <= 270) { 選單展開 = 真; 選單項目 = 範例; }
        如果 (縱 >= 332 && 縱 <= 386) { 啟動(真); }
        如果 (縱 >= 404 && 縱 <= 458) { 啟動(假); }
        如果 (縱 >= 476 && 縱 <= 530) { 停止(); }
    }
};
變數 處理按鍵 = 函式() {
    變數 按鍵 = 介面.按鍵代碼();
    如果 (按鍵 == 259) { 選單展開 = 假; }
    如果 (按鍵 == 257 || 按鍵 == 32) {
        如果 (選單展開) { 切換範例(選單項目); } 否則 { 選單展開 = 真; 選單項目 = 範例; }
    }
    如果 (選單展開 && (按鍵 == 265 || 按鍵 == 264)) { 選單項目 = 1 - 選單項目; }
};
變數 處理錯誤 = 函式() { 停止(); 狀態 = "操作失敗。請確認攝影機權限、模型與加速功能。"; };
變數 文字 = 函式(內容, 橫, 縱, 大小, 紅, 綠, 藍) { 畫.停用描邊(); 畫.填色(紅, 綠, 藍); 畫.文字大小(大小); 畫.文字(內容, 橫, 縱); };
變數 按鈕 = 函式(內容, 縱, 啟用) {
    畫.停用描邊(); 畫.填色(29, 49, 65); 如果 (啟用) { 畫.填色(30, 121, 106); }
    畫.矩形(600, 縱, 396, 54, 12); 文字(內容, 620, 縱 + 35, 18, 225, 244, 240);
};
變數 設定 = 函式() {
    介面.開啟視窗(); 畫.影格率(30); 畫.文字字型(畫.建立字型("sans-serif", 18));
    介面.註冊點擊(處理點擊); 介面.註冊按鍵(處理按鍵); 介面.註冊錯誤(處理錯誤);
};
變數 繪製 = 函式() {
    如果 (運作中) {
        變數 開始 = 目前時間();
        變數 影格 = 拍攝.擷取影格(); 圖片 = 介面.轉為繪圖圖片(影格.影像); 有圖片 = 真;
        如果 (範例 == 1) { 臉部模型.設定預覽(圖片); }
        模型.分析影像(影格.影像, 影格.時間戳記);
        變數 縮放 = 畫.最小值(512.0d / 影格.寬度, 512.0d / 影格.高度);
        影像寬 = 影格.寬度 * 縮放; 影像高 = 影格.高度 * 縮放;
        影像左 = 40 + (512 - 影像寬) / 2; 影像上 = 186 + (512 - 影像高) / 2;
        變數 完成 = 目前時間(); 影格耗時 = 完成 - 開始;
        如果 (上次影格 > 0) { 影格率 = 1000.0d / 畫.最大值(1.0d, 完成 - 上次影格); }
        上次影格 = 完成;
        狀態 = "正在尋找人物；移動或調整光線以便辨識。";
        如果 (模型.有人物) { 狀態 = "已偵測人物，正在追蹤姿態。"; }
        如果 (範例 == 1) {
            狀態 = "正在尋找臉部；請靠近攝影機並調整光線。";
            如果 (模型.有人物) { 狀態 = "已偵測臉部，正在顯示四百六十八個關鍵點。"; }
        }
    }
    直式 = 介面.寬度() < 760;
    變數 版寬 = 1040.0d; 變數 版高 = 760.0d;
    如果 (直式) { 版寬 = 592.0d; 版高 = 1320.0d; }
    比例 = 畫.最大值(0.01d, 畫.最小值(介面.寬度() / 版寬, 介面.高度() / 版高));
    左邊 = (介面.寬度() - 版寬 * 比例) / 2; 上邊 = (介面.高度() - 版高 * 比例) / 2;
    畫.背景(11, 24, 34); 畫.推入矩陣(); 畫.平移(左邊, 上邊); 畫.縮放(比例);
    文字("星泉 · MediaPipe 範例集", 40, 48, 16, 92, 216, 183);
    文字("視覺實驗室", 38, 108, 44, 231, 245, 242);
    變數 說明 = "人體姿態：三十三個關鍵點與骨架，在桌面和網頁使用相同模型。";
    如果 (範例 == 1) { 說明 = "臉部偵測：四百六十八個關鍵點，描繪眼睛、嘴唇與臉部輪廓。"; }
    如果 (直式) { 說明="在你的裝置上，即時觀察人體與臉部。"; }
    文字(說明, 40, 146, 18, 149, 179, 188);
    畫.停用描邊(); 畫.填色(20, 40, 53); 畫.矩形(40, 186, 512, 512, 14);
    如果 (有圖片) { 畫.圖片(圖片, 影像左, 影像上, 影像寬, 影像高); }
    如果 (!有圖片) {
        文字("選擇右側範例", 205, 420, 20, 149, 179, 188);
        文字("啟動攝影機，觀察即時關鍵點", 157, 454, 17, 149, 179, 188);
    }
    如果 (運作中 && 模型.有人物 && 範例 == 0) {
        變數 點 = 模型.關鍵點;
        畫.描邊(87, 228, 189); 畫.描邊粗細(3);
        迴圈 (變數 項 = 0; 項 < 長度(連線); 項++) {
            變數 邊 = 連線[項]; 變數 甲 = 邊[0]; 變數 乙 = 邊[1];
            如果 (模型.可見程度(甲) >= 0.75d && 模型.可見程度(乙) >= 0.75d) {
                畫.線段(影像左 + 點[甲 * 5] * 影像寬, 影像上 + 點[甲 * 5 + 1] * 影像高, 影像左 + 點[乙 * 5] * 影像寬, 影像上 + 點[乙 * 5 + 1] * 影像高);
            }
        }
        畫.停用描邊(); 畫.填色(249, 204, 99);
        迴圈 (變數 項 = 0; 項 < 33; 項++) {
            如果 (模型.可見程度(項) >= 0.75d) { 畫.橢圓(影像左 + 點[項 * 5] * 影像寬, 影像上 + 點[項 * 5 + 1] * 影像高, 8, 8); }
        }
    }
    如果 (運作中 && 模型.有人物 && 範例 == 1) {
        變數 點 = 模型.關鍵點;
        畫.描邊(87, 228, 189); 畫.描邊粗細(2);
        迴圈 (變數 輪廓 = 0; 輪廓 < 長度(臉部輪廓); 輪廓++) {
            變數 路徑 = 臉部輪廓[輪廓];
            迴圈 (變數 項 = 1; 項 < 長度(路徑); 項++) {
                變數 甲 = 路徑[項 - 1]; 變數 乙 = 路徑[項];
                如果 (模型.可見程度(甲) >= 0.75d && 模型.可見程度(乙) >= 0.75d) {
                    畫.線段(影像左 + 點[甲 * 3] * 影像寬, 影像上 + 點[甲 * 3 + 1] * 影像高, 影像左 + 點[乙 * 3] * 影像寬, 影像上 + 點[乙 * 3 + 1] * 影像高);
                }
            }
        }
        畫.停用描邊(); 畫.填色(249, 204, 99);
        迴圈 (變數 項 = 0; 項 < 468; 項++) {
            如果 (模型.可見程度(項) >= 0.75d) { 畫.橢圓(影像左 + 點[項 * 3] * 影像寬, 影像上 + 點[項 * 3 + 1] * 影像高, 3, 3); }
        }
    }
    如果 (直式) { 畫.推入矩陣(); 畫.平移(-560, 570); }
    文字("選擇範例", 600, 202, 20, 222, 240, 235);
    畫.停用描邊(); 畫.填色(29, 49, 65); 畫.矩形(600, 218, 396, 52, 10);
    文字(範例名稱[範例], 620, 251, 18, 225, 244, 240);
    畫.描邊(149, 179, 188); 畫.描邊粗細(2); 畫.線段(964, 240, 972, 248); 畫.線段(972, 248, 980, 240);
    文字("推論方式", 600, 312, 20, 222, 240, 235);
    按鈕("使用圖形加速", 332, 運作中 && 圖形加速);
    按鈕("使用中央處理器", 404, 運作中 && !圖形加速);
    按鈕("停止攝影機與推論", 476, 假);
    文字("模型信心", 600, 568, 15, 149, 179, 188);
    文字(畫.四捨五入(模型.信心 * 100), 600, 603, 28, 231, 245, 242);
    文字("％", 664, 603, 20, 149, 179, 188);
    文字("影格／模型耗時（毫秒）", 768, 568, 15, 149, 179, 188);
    文字(畫.四捨五入(影格耗時), 768, 603, 24, 231, 245, 242);
    文字("／", 845, 603, 20, 149, 179, 188);
    文字(畫.四捨五入(模型.模型耗時), 874, 603, 24, 231, 245, 242);
    文字("實際影格率", 600, 639, 15, 149, 179, 188);
    文字(畫.四捨五入(影格率), 600, 674, 24, 231, 245, 242);
    文字("幀／秒", 664, 674, 16, 149, 179, 188);
    文字("影像僅在你的裝置內處理。", 600, 710, 16, 149, 179, 188);
    如果 (選單展開) {
        畫.停用描邊(); 畫.填色(20, 40, 53); 畫.矩形(600, 278, 396, 100, 10);
        迴圈 (變數 項 = 0; 項 < 2; 項++) {
            如果 (項 == 選單項目) { 畫.填色(30, 121, 106); 畫.矩形(604, 282 + 項 * 50, 388, 42, 6); }
            文字(範例名稱[項], 620, 310 + 項 * 50, 18, 225, 244, 240);
        }
    }
    如果 (直式) { 畫.彈出矩陣(); }
    文字(狀態, 40, 738, 16, 205, 230, 226); 畫.彈出矩陣();
};
畫.執行(設定, 繪製);
停止();

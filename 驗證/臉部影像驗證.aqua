變數 模型 = 匯入("../臉部模型.aqua");
變數 引擎 = 匯入("推論引擎");
變數 檔案 = 匯入("Files");
變數 影像工具 = 匯入("Images");
變數 介面 = 匯入("../中文介面.aqua");
模型.載入(引擎.中央處理器);
變數 影像 = 影像工具.解碼(檔案.讀取資產位元組(目前工作目錄 + "/../驗證資料/人臉.jpg"), 0);
變數 成功 = 模型.分析影像(影像, 0) && 模型.有人物 && 長度(模型.關鍵點) == 1404;
如果 (成功) {
    變數 點 = 模型.關鍵點;
    # 鼻尖必須位於臉部中央；兩眼與嘴唇應依正常人臉的幾何順序排列。
    成功 = 點[1 * 3] > 0.2d && 點[1 * 3] < 0.8d && 點[1 * 3 + 1] > 0.2d && 點[1 * 3 + 1] < 0.8d
        && 點[33 * 3] < 點[263 * 3] && 點[33 * 3 + 1] < 點[61 * 3 + 1];
    印出("臉部信心", 模型.信心, "處理毫秒", 模型.耗時);
}
成功 = 成功 && 模型.分析影像(介面.建立空白影像(), 33) && !模型.有人物 && 長度(模型.關鍵點) == 0;
模型.釋放();
如果 (成功) { 印出("臉部影像與失去臉部驗證通過"); }
否則 { 印出("臉部影像驗證失敗"); }

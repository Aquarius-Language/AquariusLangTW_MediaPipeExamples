# MediaPipe BlazeFace 與 Face Mesh；解碼與座標還原使用同一份星泉 Wasm。
變數 引擎 = 匯入("推論引擎");
變數 畫 = 匯入("Processing");
變數 視窗 = 匯入("Window");
變數 偵測畫布 = 0;
變數 網格畫布 = 0;
變數 已準備畫布 = 假;
變數 有預覽 = 假;
變數 預覽 = 0;
變數 偵測器 = 0;
變數 網格 = 0;
變數 已載入偵測器 = 假;
變數 已載入網格 = 假;
變數 偵測輸入 = "";
變數 網格輸入 = "";
變數 偵測輸出 = [];
變數 網格輸出 = [];
變數 錨點 = [];
變數 有人物 = 假;
變數 關鍵點 = [];
變數 信心 = 0.0d;
變數 耗時 = 0.0d;
變數 模型耗時 = 0.0d;
變數 釋放 = 函式() {
    如果 (已載入網格) { 網格.釋放(); }
    如果 (已載入偵測器) { 偵測器.釋放(); }
    已載入偵測器 = 假; 已載入網格 = 假; 偵測器 = 0; 網格 = 0;
    有人物 = 假; 關鍵點 = []; 信心 = 0.0d; 耗時 = 0.0d; 模型耗時 = 0.0d;
    有預覽 = 假; 預覽 = 0;
};
變數 設定預覽 = 函式(圖片) {
    如果 (!已準備畫布) {
        偵測畫布 = 畫.建立畫布(128, 128, "P2D"); 網格畫布 = 畫.建立畫布(192, 192, "P2D"); 已準備畫布 = 真;
    }
    預覽 = 圖片; 有預覽 = 真;
};
變數 載入 = 函式(後端) {
    釋放();
    偵測器 = 引擎.建立工作階段(目前工作目錄 + "/模型/臉部偵測影像.onnx", 後端); 已載入偵測器 = 真;
    網格 = 引擎.建立工作階段(目前工作目錄 + "/模型/臉部關鍵點影像.onnx", 後端); 已載入網格 = 真;
    變數 輸入資訊 = 偵測器.取得輸入資訊(); 偵測輸入 = 輸入資訊[0].名稱;
    輸入資訊 = 網格.取得輸入資訊(); 網格輸入 = 輸入資訊[0].名稱;
    變數 輸出資訊 = 偵測器.取得輸出資訊(); 偵測輸出 = [輸出資訊[0].名稱, 輸出資訊[1].名稱];
    輸出資訊 = 網格.取得輸出資訊(); 網格輸出 = [輸出資訊[0].名稱, 輸出資訊[1].名稱];
    錨點 = [];
    # 前五百一十二個錨點：十六乘十六、每格兩個；其餘：八乘八、每格六個。
    迴圈 (變數 層 = 0; 層 < 2; 層++) {
        變數 格數 = 16; 變數 重複 = 2;
        如果 (層 == 1) { 格數 = 8; 重複 = 6; }
        迴圈 (變數 縱 = 0; 縱 < 格數; 縱++) {
            迴圈 (變數 橫 = 0; 橫 < 格數; 橫++) {
                迴圈 (變數 次 = 0; 次 < 重複; 次++) { 錨點 = 加入(錨點, [(橫 + 0.5d) / 格數, (縱 + 0.5d) / 格數]); }
            }
        }
    }
};
變數 機率 = 函式(值) { 回傳 1.0d / (1.0d + 畫.指數(-畫.限制範圍(值, -80, 80))); };
變數 取樣張量 = 函式(像素, 寬, 高, 中心橫, 中心縱, 邊長, 角度, 尺寸, 偵測) {
    如果 (有預覽) {
        # 攝影機畫面沿用繪圖後端的整批旋轉與縮放；只傳回模型尺寸的像素。
        變數 畫布 = 網格畫布; 如果 (偵測) { 畫布 = 偵測畫布; }
        畫布.開始繪圖(); 畫布.背景(0, 0, 0); 畫布.推入矩陣();
        畫布.平移(尺寸 / 2.0d + 0.5d, 尺寸 / 2.0d + 0.5d); 畫布.縮放(尺寸 * 1.0d / 邊長); 畫布.旋轉(-角度);
        畫布.圖片(預覽, -中心橫, -中心縱, 寬, 高); 畫布.彈出矩陣(); 畫布.結束繪圖();
        變數 縮圖 = 視窗.從Processing圖片(畫布);
        回傳 引擎.建立張量(引擎.無號整數8, [1, 尺寸, 尺寸, 4], 縮圖.像素());
    }
    變數 餘弦 = 畫.餘弦(角度); 變數 正弦 = 畫.正弦(角度);
    變數 資料 = [];
    變數 比例 = 邊長 * 1.0d / 尺寸;
    迴圈 (變數 縱 = 0; 縱 < 尺寸; 縱++) {
        變數 上下 = (縱 - 尺寸 / 2.0d) * 比例;
        迴圈 (變數 橫 = 0; 橫 < 尺寸; 橫++) {
            變數 左右 = (橫 - 尺寸 / 2.0d) * 比例;
            變數 原橫 = 中心橫 + 餘弦 * 左右 - 正弦 * 上下;
            變數 原縱 = 中心縱 + 正弦 * 左右 + 餘弦 * 上下;
            # 複合指定保留整數型別，在 Wasm 內截斷，再修正負數以得到向下取整。
            變數 左 = 0; 左 += 原橫; 如果 (左 > 原橫) { 左 = 左 - 1; }
            變數 上 = 0; 上 += 原縱; 如果 (上 > 原縱) { 上 = 上 - 1; }
            變數 橫分量 = 原橫 - 左; 變數 縱分量 = 原縱 - 上;
            變數 左上 = -1; 變數 右上 = -1; 變數 左下 = -1; 變數 右下 = -1;
            如果 (左 >= 0 && 左 < 寬 && 上 >= 0 && 上 < 高) { 左上 = (上 * 寬 + 左) * 4; }
            如果 (左 + 1 >= 0 && 左 + 1 < 寬 && 上 >= 0 && 上 < 高) { 右上 = (上 * 寬 + 左 + 1) * 4; }
            如果 (左 >= 0 && 左 < 寬 && 上 + 1 >= 0 && 上 + 1 < 高) { 左下 = ((上 + 1) * 寬 + 左) * 4; }
            如果 (左 + 1 >= 0 && 左 + 1 < 寬 && 上 + 1 >= 0 && 上 + 1 < 高) { 右下 = ((上 + 1) * 寬 + 左 + 1) * 4; }
            變數 顏色 = [0.0d, 0.0d, 0.0d];
            迴圈 (變數 色 = 0; 色 < 3; 色++) {
                變數 甲 = 0.0d; 變數 乙 = 0.0d; 變數 丙 = 0.0d; 變數 丁 = 0.0d;
                如果 (左上 >= 0) { 甲 = 像素[左上 + 色]; } 如果 (右上 >= 0) { 乙 = 像素[右上 + 色]; }
                如果 (左下 >= 0) { 丙 = 像素[左下 + 色]; } 如果 (右下 >= 0) { 丁 = 像素[右下 + 色]; }
                變數 值 = (甲 * (1 - 橫分量) + 乙 * 橫分量) * (1 - 縱分量) + (丙 * (1 - 橫分量) + 丁 * 橫分量) * 縱分量;
                顏色[色] = 畫.四捨五入(值);
            }
            資料 = 加入(資料, 顏色[0]); 資料 = 加入(資料, 顏色[1]); 資料 = 加入(資料, 顏色[2]); 資料 = 加入(資料, 255);
        }
    }
    回傳 引擎.建立張量(引擎.無號整數8, [1, 尺寸, 尺寸, 4], 資料);
};
變數 解碼 = 函式(框, 項) {
    變數 錨 = 錨點[項]; 變數 起 = 項 * 16;
    回傳 [框[起] / 128.0d + 錨[0], 框[起 + 1] / 128.0d + 錨[1], 框[起 + 2] / 128.0d, 框[起 + 3] / 128.0d,
        框[起 + 4] / 128.0d + 錨[0], 框[起 + 5] / 128.0d + 錨[1], 框[起 + 6] / 128.0d + 錨[0], 框[起 + 7] / 128.0d + 錨[1]];
};
變數 重疊 = 函式(甲, 乙) {
    變數 寬 = 畫.最大值(0, 畫.最小值(甲[0] + 甲[2] / 2, 乙[0] + 乙[2] / 2) - 畫.最大值(甲[0] - 甲[2] / 2, 乙[0] - 乙[2] / 2));
    變數 高 = 畫.最大值(0, 畫.最小值(甲[1] + 甲[3] / 2, 乙[1] + 乙[3] / 2) - 畫.最大值(甲[1] - 甲[3] / 2, 乙[1] - 乙[3] / 2));
    變數 交集 = 寬 * 高;
    回傳 交集 / 畫.最大值(0.000000001d, 甲[2] * 甲[3] + 乙[2] * 乙[3] - 交集);
};
變數 分析影像 = 函式(影像, 時間) {
    變數 開始 = 目前時間(); 有人物 = 假; 關鍵點 = []; 信心 = 0.0d; 模型耗時 = 0.0d;
    變數 寬 = 影像.width; 變數 高 = 影像.height; 變數 像素 = [];
    如果 (!有預覽) { 像素 = 影像.像素(); }
    變數 邊長 = 畫.最大值(寬, 高);
    變數 輸入 = 取樣張量(像素, 寬, 高, 寬 / 2.0d, 高 / 2.0d, 邊長, 0.0d, 128, 真);
    變數 推論開始 = 目前時間(); 變數 輸出 = 偵測器.推論([偵測輸入], [輸入], 偵測輸出); 模型耗時 = 目前時間() - 推論開始;
    變數 框 = 輸出[0].取得資料(); 變數 分數 = 輸出[1].取得資料();
    變數 最佳 = -1; 變數 最高 = 0.0d;
    迴圈 (變數 項 = 0; 項 < 896; 項++) {
        如果 (分數[項] >= 0 && (最佳 < 0 || 分數[項] > 最高)) { 最佳 = 項; 最高 = 分數[項]; }
    }
    如果 (最佳 >= 0) {
        變數 主要 = 解碼(框, 最佳); 變數 平均 = [0.0d, 0.0d, 0.0d, 0.0d, 0.0d, 0.0d, 0.0d, 0.0d]; 變數 權重 = 0.0d;
        迴圈 (變數 項 = 0; 項 < 896; 項++) {
            如果 (分數[項] >= 0) {
                變數 候選 = 解碼(框, 項);
                如果 (候選[2] > 0 && 候選[3] > 0 && 重疊(主要, 候選) > 0.3d) {
                    變數 比重 = 機率(分數[項]); 權重 = 權重 + 比重;
                    迴圈 (變數 值 = 0; 值 < 8; 值++) { 平均[值] = 平均[值] + 候選[值] * 比重; }
                }
            }
        }
        如果 (權重 > 0) {
            迴圈 (變數 值 = 0; 值 < 8; 值++) { 平均[值] = 平均[值] / 權重; }
            變數 中心橫 = (平均[0] - 0.5d) * 邊長 + 寬 / 2.0d; 變數 中心縱 = (平均[1] - 0.5d) * 邊長 + 高 / 2.0d;
            變數 裁切邊長 = 畫.最大值(平均[2], 平均[3]) * 邊長 * 1.5d;
            變數 角度 = 畫.雙參數反正切(平均[7] - 平均[5], 平均[6] - 平均[4]);
            輸入 = 取樣張量(像素, 寬, 高, 中心橫, 中心縱, 裁切邊長, 角度, 192, 假);
            推論開始 = 目前時間(); 輸出 = 網格.推論([網格輸入], [輸入], 網格輸出); 模型耗時 = 模型耗時 + 目前時間() - 推論開始;
            變數 點 = 輸出[0].取得資料(); 變數 存在 = 輸出[1].取得資料(); 信心 = 機率(存在[0]);
            如果 (信心 >= 0.75d && 長度(點) == 1404) {
                有人物 = 真; 變數 餘弦 = 畫.餘弦(角度); 變數 正弦 = 畫.正弦(角度);
                迴圈 (變數 項 = 0; 項 < 468; 項++) {
                    變數 左右 = (點[項 * 3] / 192.0d - 0.5d) * 裁切邊長; 變數 上下 = (點[項 * 3 + 1] / 192.0d - 0.5d) * 裁切邊長;
                    關鍵點 = 加入(關鍵點, (中心橫 + 餘弦 * 左右 - 正弦 * 上下) / 寬);
                    關鍵點 = 加入(關鍵點, (中心縱 + 正弦 * 左右 + 餘弦 * 上下) / 高);
                    關鍵點 = 加入(關鍵點, 點[項 * 3 + 2] / 192.0d * 裁切邊長 / 寬);
                }
            }
        }
    }
    耗時 = 目前時間() - 開始;
    回傳 (!有人物 && 長度(關鍵點) == 0) || (有人物 && 長度(關鍵點) == 1404);
};
變數 可見程度 = 函式(項) {
    如果 (!有人物) { 回傳 0.0d; }
    變數 橫 = 關鍵點[項 * 3]; 變數 縱 = 關鍵點[項 * 3 + 1];
    如果 (橫 < 0 || 橫 > 1 || 縱 < 0 || 縱 > 1) { 回傳 0.0d; }
    回傳 信心;
};
